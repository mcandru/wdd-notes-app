PORT=8000

# The name the app shows on the page and sends in the X-Instance-Name header.
# On ECS the app shows the task ID instead, and ignores this value.
INSTANCE_NAME=local

# The longest note the app accepts. On ECS it comes from Parameter Store.
MAX_NOTE_LENGTH=500

# The bucket for files attached to notes. Leave it unset and files are written
# to backend/uploads instead. On ECS it comes from Parameter Store, and the
# task role gives the app permission to use the bucket.
# S3_BUCKET=notes-ecs-123456789012
# AWS_REGION=eu-west-1
