PORT=8000

# The MySQL database the notes are stored in.
#
# These are the settings for the database the README tells you to start in
# Docker. A deployed copy of the app points at a different database, but it
# reads the same five variables to find it.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=notes
DB_NAME=notes

# Where uploaded files go.
#
# Leave S3_BUCKET unset and the app writes them to backend/uploads, so that it
# runs on a laptop with no AWS account and no bucket.
#
# Set both of these and the app stores them in S3 instead.

# S3_BUCKET=notes-app-uploads-yourname
# AWS_REGION=eu-west-1
